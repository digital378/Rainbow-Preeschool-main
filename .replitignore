# Workspace and version-control metadata
.git/
.agents/
.local/
.local/walkthrough-src/
.cache/
.superpowers/

# Uploaded source originals are not runtime assets.
# Optimized images used by the app live under public/, client/, or blog-pages/.
attached_assets/

# Design-only previews and local verification output
artifacts/
screenshots/
seo-audits/

# Build-time dependencies are available during publishing; runtime server
# dependencies are bundled into dist/index.cjs by script/build.ts.
node_modules/

# Local editor/build residue
*.log
*.tmp
*.tsbuildinfo