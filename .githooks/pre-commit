#!/bin/sh
#
# Pre-commit hook: runs the local code checks (`npm run check`).
#
# This guards against:
#   - JSON-LD `Person` author/reviewer/contributor entries sneaking back in
#     (scripts/check-no-person-author.ts — run explicitly AND via npm run check)
#   - TypeScript regressions (`tsc`)
#   - Off-brand pink colour usage (scripts/check-no-pink.ts) — the
#     Rainbow Preschool brand uses red/primary (#dc2626) only.
#   - SEO title keyword cannibalization and soft-marketing words
#     (scripts/check-no-title-cannibalisation.ts)
#   - Meta-description exceeding 155 chars — Google truncates SERP snippets
#     around that length (scripts/check-description-length.ts)
#   - SSR ↔ client H1 drift across 29 pages (scripts/check-h1-parity.ts)
#
# Enable this hook once with:
#     bash scripts/install-hooks.sh
# (or manually:  git config core.hooksPath .githooks)
#
# Skip a single commit (e.g. emergency fix) with:
#     git commit --no-verify

set -e

# Allow opting out via env var, e.g. SKIP_PRECOMMIT=1 git commit ...
if [ "${SKIP_PRECOMMIT:-0}" = "1" ]; then
  echo "[pre-commit] SKIP_PRECOMMIT=1 set — skipping npm run check."
  exit 0
fi

# Fail closed if npm isn't available — we can't verify the tree without it.
if ! command -v npm >/dev/null 2>&1; then
  echo "[pre-commit] 'npm' not found on PATH — cannot run 'npm run check'." >&2
  echo "[pre-commit] Install Node.js / npm, or bypass once with --no-verify" >&2
  echo "[pre-commit] (or SKIP_PRECOMMIT=1) if you know the change is safe." >&2
  exit 1
fi

echo "[pre-commit] Running 'npm run check' ..."
if ! npm run --silent check; then
  echo "" >&2
  echo "[pre-commit] 'npm run check' failed. Commit aborted." >&2
  echo "[pre-commit] Fix the issues above, or re-run with --no-verify to bypass." >&2
  exit 1
fi

# No-pink brand-colour guard. Run separately so it stays enforced even
# if package.json's `check` script is ever changed; the deploy gate
# (scripts/predeploy.sh) runs the same script.
echo "[pre-commit] Running 'tsx scripts/check-no-pink.ts' ..."
if ! npx --no-install tsx scripts/check-no-pink.ts; then
  echo "" >&2
  echo "[pre-commit] 'check-no-pink' failed. Commit aborted." >&2
  echo "[pre-commit] Fix the issues above, or re-run with --no-verify to bypass." >&2
  exit 1
fi

# Title de-cannibalisation guard. Same rationale as check-no-pink — keep it
# enforced independently of npm run check so it stays wired even if package.json
# is edited.
echo "[pre-commit] Running 'tsx scripts/check-no-title-cannibalisation.ts' ..."
if ! npx --no-install tsx scripts/check-no-title-cannibalisation.ts; then
  echo "" >&2
  echo "[pre-commit] 'check-no-title-cannibalisation' failed. Commit aborted." >&2
  echo "[pre-commit] Fix the issues above, or re-run with --no-verify to bypass." >&2
  exit 1
fi

# Meta-description length guard. Google truncates SERP snippets around 155
# chars on desktop; this guard fails the commit if any title-source file ships
# a description longer than that. Wired alongside the title guard for the same
# reason: stays enforced even if package.json is edited.
echo "[pre-commit] Running 'tsx scripts/check-description-length.ts' ..."
if ! npx --no-install tsx scripts/check-description-length.ts; then
  echo "" >&2
  echo "[pre-commit] 'check-description-length' failed. Commit aborted." >&2
  echo "[pre-commit] Fix the issues above, or re-run with --no-verify to bypass." >&2
  exit 1
fi

# Admissions HowTo schema sync guard. Verifies that both server/ssr-pages.ts
# and client/src/pages/preschool-admissions.tsx import admissionHowToSchema
# from @shared/admissions-howto-data and neither defines a local HowTo override.
echo "[pre-commit] Running 'tsx scripts/check-admissions-howto-sync.ts' ..."
if ! npx --no-install tsx scripts/check-admissions-howto-sync.ts; then
  echo "" >&2
  echo "[pre-commit] 'check-admissions-howto-sync' failed. Commit aborted." >&2
  echo "[pre-commit] Both server/ssr-pages.ts and client/src/pages/preschool-admissions.tsx" >&2
  echo "[pre-commit] must import admissionHowToSchema from @shared/admissions-howto-data." >&2
  echo "[pre-commit] Fix the issues above, or re-run with --no-verify to bypass." >&2
  exit 1
fi

# H1 parity guard. Verifies that the h1: field in server/ssr-pages.ts
# staticPages matches the <h1> rendered by the corresponding client page
# component. Googlebot indexes the SSR h1; users see the React h1 — drift
# between the two is an SEO regression.
echo "[pre-commit] Running 'tsx scripts/check-h1-parity.ts' ..."
if ! npx --no-install tsx scripts/check-h1-parity.ts; then
  echo "" >&2
  echo "[pre-commit] 'check-h1-parity' failed. Commit aborted." >&2
  echo "[pre-commit] Fix the issues above, or re-run with --no-verify to bypass." >&2
  exit 1
fi

# Person-author guard. Scans the live codebase for JSON-LD Person author/
# reviewer/contributor nodes and unapproved visible-byline name literals.
# Wired explicitly here (independent of npm run check) so it stays enforced
# even if package.json's `check` script is restructured or skipped.
echo "[pre-commit] Running 'tsx scripts/check-no-person-author.ts' ..."
if ! npx --no-install tsx scripts/check-no-person-author.ts; then
  echo "" >&2
  echo "[pre-commit] 'check-no-person-author' failed. Commit aborted." >&2
  echo "[pre-commit] Fix the issues above, or re-run with --no-verify to bypass." >&2
  exit 1
fi

# Person-author guard regression tests. Verifies the guard itself hasn't
# regressed — tests run in <1 s and have no side effects. Running here (not
# just pre-push) gives early feedback before the commit lands locally.
echo "[pre-commit] Running 'tsx --test scripts/check-no-person-author.test.ts' ..."
if ! npx --no-install tsx --test scripts/check-no-person-author.test.ts; then
  echo "" >&2
  echo "[pre-commit] 'check-no-person-author' tests failed. Commit aborted." >&2
  echo "[pre-commit] Fix the issues above, or re-run with --no-verify to bypass." >&2
  exit 1
fi

# Body-copy cannibalisation guard regression tests. Verifies the guard itself
# hasn't regressed — tests run in <1 s and have no side effects. Running here
# (not just pre-push) gives early feedback before the commit lands locally.
echo "[pre-commit] Running 'tsx --test scripts/check-body-copy-cannibalisation.test.ts' ..."
if ! npx --no-install tsx --test scripts/check-body-copy-cannibalisation.test.ts; then
  echo "" >&2
  echo "[pre-commit] 'check-body-copy-cannibalisation' tests failed. Commit aborted." >&2
  echo "[pre-commit] Fix the issues above, or re-run with --no-verify to bypass." >&2
  exit 1
fi

# Body-copy keyword-cannibalization guard. Catches reserved keyword phrases
# appearing as unquoted JSX body text on non-canonical pages — a class of SEO
# regression that the title guard does not cover.
echo "[pre-commit] Running 'tsx scripts/check-body-copy-cannibalisation.ts' ..."
if ! npx --no-install tsx scripts/check-body-copy-cannibalisation.ts; then
  echo "" >&2
  echo "[pre-commit] 'check-body-copy-cannibalisation' failed. Commit aborted." >&2
  echo "[pre-commit] Fix the issues above, or re-run with --no-verify to bypass." >&2
  exit 1
fi

# EEATSignals showRating guard. Every <EEATSignals> call in client/src/pages/
# must pass showRating={false} explicitly. The prop defaults to true, which
# emits star-rating rich-result markup — publishing unverified ratings violates
# Google's rich-result policy.
echo "[pre-commit] Running 'tsx scripts/check-eeat-show-rating.ts' ..."
if ! npx --no-install tsx scripts/check-eeat-show-rating.ts; then
  echo "" >&2
  echo "[pre-commit] 'check-eeat-show-rating' failed. Commit aborted." >&2
  echo "[pre-commit] Fix the issues above, or re-run with --no-verify to bypass." >&2
  exit 1
fi

# Shell ↔ React SEO sync guard. Verifies that the title, description, og:title,
# og:description, twitter:title, and twitter:description in client/index.html
# match the <SEO> component props in client/src/pages/home.tsx. Social scrapers
# and crawlers read the static shell before JS runs — drift between the two
# causes stale social cards and incorrect pre-hydration metadata.
echo "[pre-commit] Running 'tsx scripts/check-no-client-schema-injection.ts' ..."
if ! npx --no-install tsx scripts/check-no-client-schema-injection.ts; then
  echo "" >&2
  echo "[pre-commit] 'check-no-client-schema-injection' failed. Commit aborted." >&2
  echo "[pre-commit] A new application/ld+json DOM injection was added to a client page" >&2
  echo "[pre-commit] or component that is not on the allowlist. Move the schema to" >&2
  echo "[pre-commit] server/ssr-pages.ts, or add the file to the DEFERRED_ALLOWLIST" >&2
  echo "[pre-commit] in scripts/check-no-client-schema-injection.ts with an AUDIT comment." >&2
  exit 1
fi

echo "[pre-commit] Running 'tsx scripts/check-shell-seo-sync.ts' ..."
if ! npx --no-install tsx scripts/check-shell-seo-sync.ts; then
  echo "" >&2
  echo "[pre-commit] 'check-shell-seo-sync' failed. Commit aborted." >&2
  echo "[pre-commit] Update client/index.html and client/src/pages/home.tsx together," >&2
  echo "[pre-commit] or re-run with --no-verify to bypass." >&2
  exit 1
fi

# Record success so the pre-push hook can skip a redundant re-run on
# the same tree. Best-effort only — never fail the commit on this.
REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || true)"
HEAD_TREE="$(git write-tree 2>/dev/null || true)"
if [ -n "$REPO_ROOT" ] && [ -n "$HEAD_TREE" ]; then
  printf '%s' "$HEAD_TREE" > "$REPO_ROOT/.git/.npm-check-ok" 2>/dev/null || true
fi

echo "[pre-commit] Checks passed."
exit 0
