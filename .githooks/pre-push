#!/bin/sh
#
# Pre-push hook: second safety net on top of `.githooks/pre-commit`.
#
# The pre-commit hook can be bypassed (`git commit --no-verify`,
# `SKIP_PRECOMMIT=1`), so a teammate can still wind up trying to push
# code that doesn't pass `npm run check`. This hook re-runs the same
# suite of checks on push and aborts the push on failure:
#   - npm run check  (TypeScript + existing lint/test scripts)
#   - scripts/check-no-pink.ts                      (brand colour guard)
#   - scripts/check-no-title-cannibalisation.ts      (SEO keyword guard)
#   - scripts/check-description-length.ts            (meta-description ≤ 155 chars)
#   - scripts/check-bot-ua-list.ts                   (bot UA allowlist guard)
#   - scripts/check-h1-parity.ts                     (SSR ↔ client H1 parity, 29 pages)
#   - scripts/check-no-person-author.test.ts          (person-author guard regression tests)
#   - scripts/check-body-copy-cannibalisation.ts       (reserved phrases in JSX body copy)
#
# To avoid re-running a full type-check when the pre-commit hook
# *just* ran successfully on the same tree, both hooks write the
# git tree-ish of HEAD to `.git/.npm-check-ok` after a successful
# run. If HEAD's tree still matches, we skip.
#
# Enable this hook once with:
#     bash scripts/install-hooks.sh
# (or manually:  git config core.hooksPath .githooks)
#
# Bypass a single push (e.g. emergency hotfix) with:
#     git push --no-verify
# or:
#     SKIP_PREPUSH=1 git push ...

set -e

if [ "${SKIP_PREPUSH:-0}" = "1" ]; then
  echo "[pre-push] SKIP_PREPUSH=1 set — skipping npm run check."
  exit 0
fi

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || true)"
if [ -z "$REPO_ROOT" ]; then
  echo "[pre-push] not inside a git working tree — skipping." >&2
  exit 0
fi

CACHE_FILE="$REPO_ROOT/.git/.npm-check-ok"
HEAD_TREE="$(git rev-parse HEAD^{tree} 2>/dev/null || true)"

if [ -n "$HEAD_TREE" ] && [ -f "$CACHE_FILE" ]; then
  CACHED="$(cat "$CACHE_FILE" 2>/dev/null || true)"
  if [ "$CACHED" = "$HEAD_TREE" ]; then
    echo "[pre-push] 'npm run check' already passed for this tree — skipping."
    exit 0
  fi
fi

# Fail closed if npm isn't available — we can't verify the tree without it.
if ! command -v npm >/dev/null 2>&1; then
  echo "[pre-push] 'npm' not found on PATH — cannot run 'npm run check'." >&2
  echo "[pre-push] Install Node.js / npm, or bypass once with --no-verify" >&2
  echo "[pre-push] (or SKIP_PREPUSH=1) if you know the change is safe." >&2
  exit 1
fi

echo "[pre-push] Running 'npm run check' ..."
if ! npm run --silent check; then
  echo "" >&2
  echo "[pre-push] 'npm run check' failed. Push aborted." >&2
  echo "[pre-push] Fix the issues above, or re-run with --no-verify to bypass." >&2
  exit 1
fi

# Mirror pre-commit: also run the brand-colour, title, and H1 guards so a
# push can't sneak past them even if package.json's `check` script is changed.
echo "[pre-push] Running 'tsx scripts/check-no-pink.ts' ..."
if ! npx --no-install tsx scripts/check-no-pink.ts; then
  echo "" >&2
  echo "[pre-push] 'check-no-pink' failed. Push aborted." >&2
  echo "[pre-push] Fix the issues above, or re-run with --no-verify to bypass." >&2
  exit 1
fi

echo "[pre-push] Running 'tsx scripts/check-no-title-cannibalisation.ts' ..."
if ! npx --no-install tsx scripts/check-no-title-cannibalisation.ts; then
  echo "" >&2
  echo "[pre-push] 'check-no-title-cannibalisation' failed. Push aborted." >&2
  echo "[pre-push] Fix the issues above, or re-run with --no-verify to bypass." >&2
  exit 1
fi

echo "[pre-push] Running 'tsx scripts/check-description-length.ts' ..."
if ! npx --no-install tsx scripts/check-description-length.ts; then
  echo "" >&2
  echo "[pre-push] 'check-description-length' failed. Push aborted." >&2
  echo "[pre-push] Fix the issues above, or re-run with --no-verify to bypass." >&2
  exit 1
fi

echo "[pre-push] Running 'tsx scripts/check-bot-ua-list.ts' ..."
if ! npx --no-install tsx scripts/check-bot-ua-list.ts; then
  echo "" >&2
  echo "[pre-push] 'check-bot-ua-list' failed. Push aborted." >&2
  echo "[pre-push] A social-app in-app browser UA (WhatsApp, Pinterest, Instagram) was found in" >&2
  echo "[pre-push] BOT_USER_AGENTS. Real users must get the React shell, not the SSR page." >&2
  echo "[pre-push] Fix server/bot-ssr.ts, or re-run with --no-verify to bypass." >&2
  exit 1
fi

echo "[pre-push] Running 'tsx scripts/check-h1-parity.ts' ..."
if ! npx --no-install tsx scripts/check-h1-parity.ts; then
  echo "" >&2
  echo "[pre-push] 'check-h1-parity' failed. Push aborted." >&2
  echo "[pre-push] The h1: in server/ssr-pages.ts and the <h1> in the client page must match." >&2
  echo "[pre-push] Fix the issues above, or re-run with --no-verify to bypass." >&2
  exit 1
fi

echo "[pre-push] Running person-author guard regression tests ..."
if ! npx --no-install tsx --test scripts/check-no-person-author.test.ts; then
  echo "" >&2
  echo "[pre-push] 'check-no-person-author' regression tests failed. Push aborted." >&2
  echo "[pre-push] The person-author guard itself has a bug — fix scripts/check-no-person-author.ts" >&2
  echo "[pre-push] before pushing, or re-run with --no-verify to bypass." >&2
  exit 1
fi

echo "[pre-push] Running body-copy cannibalisation guard regression tests ..."
if ! npx --no-install tsx --test scripts/check-body-copy-cannibalisation.test.ts; then
  echo "" >&2
  echo "[pre-push] 'check-body-copy-cannibalisation' regression tests failed. Push aborted." >&2
  echo "[pre-push] The body-copy cannibalisation guard itself has a bug — fix scripts/check-body-copy-cannibalisation.ts" >&2
  echo "[pre-push] before pushing, or re-run with --no-verify to bypass." >&2
  exit 1
fi

# Body-copy keyword-cannibalization guard. Catches reserved keyword phrases
# appearing as unquoted JSX body text on non-canonical pages — a class of SEO
# regression that the title guard does not cover.
echo "[pre-push] Running 'tsx scripts/check-body-copy-cannibalisation.ts' ..."
if ! npx --no-install tsx scripts/check-body-copy-cannibalisation.ts; then
  echo "" >&2
  echo "[pre-push] 'check-body-copy-cannibalisation' failed. Push aborted." >&2
  echo "[pre-push] Unquoted reserved keyword phrase found in JSX body copy on a non-canonical page." >&2
  echo "[pre-push] Fix the issues above, or re-run with --no-verify to bypass." >&2
  exit 1
fi

# EEATSignals showRating guard. Every <EEATSignals> call in client/src/pages/
# must pass showRating={false} explicitly. The prop defaults to true, which
# emits star-rating rich-result markup — publishing unverified ratings violates
# Google's rich-result policy.
echo "[pre-push] Running 'tsx scripts/check-eeat-show-rating.ts' ..."
if ! npx --no-install tsx scripts/check-eeat-show-rating.ts; then
  echo "" >&2
  echo "[pre-push] 'check-eeat-show-rating' failed. Push aborted." >&2
  echo "[pre-push] A <EEATSignals> call is missing showRating={false} in client/src/pages/." >&2
  echo "[pre-push] Fix the issues above, or re-run with --no-verify to bypass." >&2
  exit 1
fi

# Record success so a subsequent push on the same tree can skip.
if [ -n "$HEAD_TREE" ]; then
  printf '%s' "$HEAD_TREE" > "$CACHE_FILE" 2>/dev/null || true
fi

echo "[pre-push] Checks passed."
exit 0
